# Copy this file to ".env" (setup.bat does it for you) and fill in the values.
# NEVER share the .env file or post it anywhere: it contains your bot token.

# Token from @BotFather (looks like 123456789:AAH...)
BOT_TOKEN=8789608219:AAH00Np1zQdgHVMfUbFjDbU8gkxXiESC0OI

# Dispatchers who may use admin commands. Telegram user IDs (numbers), separated by commas.
# Find yours by sending /myid to the bot.
ADMIN_IDS=7204739780

# Optional. Leave empty and send /setgroup inside the group instead (easier).
GROUP_CHAT_ID=

# Morning message. Time is 24-hour HH:MM in the timezone below.
TIMEZONE=America/Chicago
GREETING_TIME=07:00
# Days the morning message is sent. All week by default; example for weekdays: Mon,Tue,Wed,Thu,Fri
GREETING_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
# Optional: your own wording (one line; write \n for a new line)
MORNING_MESSAGE=

# If the PC was off at the greeting time, still send it when the bot starts within this many minutes.
GREETING_CATCHUP_MINUTES=120
# Minimum minutes between two /refresh commands
REFRESH_COOLDOWN_MINUTES=30
# Hide drivers from /available if they haven't updated for this many hours (0 = never hide)
STALE_HOURS=18

# Send dispatchers a private message when a driver becomes available with a ZIP code
NOTIFY_ADMINS=true
# Set to true ONLY to test alone (dispatcher messages are then treated like driver messages)
TREAT_ADMINS_AS_DRIVERS=false

# Where the database is stored, and how much detail to log
DB_PATH=data/dispatch.sqlite3
LOG_LEVEL=INFO
